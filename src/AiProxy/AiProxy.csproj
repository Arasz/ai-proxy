<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
        <RootNamespace>AiProxy</RootNamespace>
        <AssemblyName>AiProxy</AssemblyName>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <PackageType>DotnetTool</PackageType>
        <PackageId>ai-proxy</PackageId>
        <ToolCommandName>ai-proxy</ToolCommandName>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>llm proxy anthropic openai gemini ai agent developer-tool dotnet-tool global-tool tool cli</PackageTags>
        <Authors>Rafał Araszkiewicz</Authors>
        <Copyright>Copyright (c) 2026 Rafał Araszkiewicz</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Arasz/ai-proxy</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Arasz/ai-proxy</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>A machine-wide local HTTP(S) forward proxy that inspects canonical LLM provider traffic and passes all other destinations through.</Description>
        <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../AiProxy.Cli/AiProxy.Cli.csproj" />
        <ProjectReference Include="../AiProxy.Code/AiProxy.Code.csproj" />
        <ProjectReference Include="../AiProxy.Mcp/AiProxy.Mcp.csproj" />
        <ProjectReference Include="../AiProxy.Core/AiProxy.Core.csproj" />
        <ProjectReference Include="../AiProxy.Storage/AiProxy.Storage.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The package page is where someone lands after `dotnet tool install`; the
             README is what they read there. -->
        <None Include="../../README.md" Pack="true" PackagePath="/" />
        <None Include="../../content/icon.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AiProxy.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="JsonSchema.Net" />
      <PackageReference Include="Titanium.Web.Proxy" />
    </ItemGroup>

</Project>
