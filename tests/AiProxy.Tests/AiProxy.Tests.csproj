<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="Spectre.Console.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/AiProxy.Core/AiProxy.Core.csproj"/>
        <ProjectReference Include="../../src/AiProxy.Code/AiProxy.Code.csproj"/>
        <ProjectReference Include="../../scripts/CodeReducerCore/CodeReducerCore.csproj"/>
        <ProjectReference Include="../../src/AiProxy/AiProxy.csproj"/>
        <ProjectReference Include="../../src/AiProxy.Storage/AiProxy.Storage.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The integration tests start the real host, so they need the web stack. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The scored payloads and their pre-registered answers, shared with the scoring harness. -->
        <None Include="../../scripts/reducer_scoring/payloads/*.txt" Link="ReducerScoring/payloads/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="../../scripts/reducer_scoring/preregistration.json" Link="ReducerScoring/preregistration.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
