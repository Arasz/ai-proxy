<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable><IsTestProject>true</IsTestProject></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.NET.Test.Sdk"/><PackageReference Include="xunit.v3"/><PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all"/></ItemGroup>
  <ItemGroup><ProjectReference Include="../../src/AiProxy.Mcp/AiProxy.Mcp.csproj"/><FrameworkReference Include="Microsoft.AspNetCore.App"/></ItemGroup>
  <ItemGroup><Using Include="Xunit"/></ItemGroup>
  <Target Name="CopyMcpProcess" AfterTargets="Build">
    <ItemGroup><McpProcessFiles Include="../../src/AiProxy.Mcp/bin/$(Configuration)/net10.0/**/*"/></ItemGroup>
    <Copy SourceFiles="@(McpProcessFiles)" DestinationFiles="@(McpProcessFiles->'$(OutDir)mcp/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
  </Target>
</Project>
